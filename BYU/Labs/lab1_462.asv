%% Part 1
eps_0 = 8.85e-12;
mu_0 = pi*4e-7;
freq = 300e8;

dx = 0.01;
dy = 0.01;
x = 0:dx:5;
y = 0:dy:5;

X = meshgrid(x);
Y = meshgrid(y);


figure(1)
f = cos(X);
% f = X.^2 + Y.^2;
imagesc(x,y,f)
set(gca,'ydir','normal')
xlabel('x')
ylabel('y')

%% Part 2b
eps_0 = 8.85e-12;
mu_0 = pi*4e-7;
freq = 300e8;

dx = 0.01;
dy = 0.01;
x = 0:dx:5;
y = 0:dy:5;

[X, Y] = meshgrid(x, y);



figure(1)
f = cos(-2*pi.*X);
imagesc(x,y,f)
set(gca,'ydir','normal')
xlabel('x')
ylabel('y')
colorbar();

%% Part 2c
eps_0 = 8.85e-12;
mu_0 = pi*4e-7;
freq = 300e8;

dx = 0.01;
dy = 0.01;
x = 0:dx:5;
y = 0:dy:5;

[X, Y] = meshgrid(x, y);

figure(1)
% dt = 4.6296e-11;
dt = (5*pi / 180) / (freq * 2 * pi);


for n = 1:100
    t = (n-1)*dt;
    Ez = cos(2*pi*freq*t - 2*pi.*X);
    figure(1)
    imagesc(x,y,Ez)
    set(gca,'ydir','normal')
    xlabel('x')
    ylabel('y')
    M(n) = getframe;
end

%% Part 3

eps_0 = 8.85e-12;
mu_0 = pi*4e-7;
freq = 300e8;
sigma = 0.01;

dx = 0.01;
dy = 0.01;
x = 0:dx:5;
y = 0:dy:5;

[X, Y] = meshgrid(x, y);


figure(1)
f = exp(-1.81.*X) .* cos(-2*pi.*X);
imagesc(x,y,f)
set(gca,'ydir','normal')
xlabel('x')
ylabel('y')
colorbar();

%% Part 4

eps_0 = 8.85e-12;
mu_0 = pi*4e-7;
freq = 300e8;
sigma = 0.01;

dx = 0.01;
dy = 0.01;
x = 0:dx:5;
y = 0:dy:5;

[X, Y] = meshgrid(x, y);


figure(1)
phi = 20 * pi/180;
f = cos(-2*pi*(X.*cos(phi) + Y.*sin(phi)));
imagesc(x,y,f)
set(gca,'ydir','normal')
xlabel('x')
ylabel('y')
colorbar();


%% Part 5
eps_0 = 8.85e-12;
mu_0 = pi*4e-7;
freq = 300e8;
sigma = 0.01;
phi = 20 * pi/180;

dx = 0.01;
dy = 0.01;
x = -5:dx:5;
y = 5:dy:5;
xn = -5:dx:5;
[X, Y] = meshgrid(x, y);
[Xn]

eps_r2 = 2;
phi_t = arcsin((1/sqrt(eps_r2)) * sin(phi));
gamma = (cos(phi) - sqrt(eps_r2)*cos(phi_t)) / (cos(phi) + sqrt(eps_r2)*cos(phi_t));
T = 1 + gamma;

E1 = cos(-2*pi.*X.*cos(phi) - 2*pi.*Y.*sin(phi)) + gamma * cos(-2*pi.*X.*cos(phi) + 2*pi.*Y.*sin(phi));
E2 = T * cos(-X.*cos(phi)*sqrt(2)*2*pi - y*sin(phi)*sqrt(2)*2*pi);



figure(1)
imagesc(x,y,[E1, E2])
set(gca,'ydir','normal')
xlabel('x')
ylabel('y')
colorbar();